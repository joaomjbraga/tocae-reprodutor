{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "io.github.joaomjbraga.tocae-reprodutor",
  "asar": true,
  "productName": "Tocaê Reprodutor",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "linux": {
    "icon": "build/icons"
  }
}
