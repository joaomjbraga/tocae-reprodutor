// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.joaomjbraga.tocae-reprodutor",
  "asar": true,
  "productName": "Tocaê Reprodutor",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "linux": {
    "target": [
      "rpm"
    ],
    "icon": "build/icons",
    "artifactName": "tocae-reprodutor-${version}.${ext}",
    "category": "AudioVideo",
    "maintainer": "João M J Braga <joaomarcos.jbraga@gmail.com>",
    "synopsis": "Reprodutor de vídeo minimalista",
    "description": "Tocaê Reprodutor abre um vídeo e reproduz, com timeline, play/pause e tela cheia."
  }
}
